{
  "rules": {
    ".read": false,
    ".write": false,

    "conversationMembers": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && ((($conversationId.beginsWith('direct_' + auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && $conversationId.matches(/^direct_[A-Za-z0-9]+_[A-Za-z0-9]+$/)) || root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true)",
        ".indexOn": ["createdAt"],

        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && ((($conversationId.beginsWith('direct_' + auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && $conversationId.matches(/^direct_[A-Za-z0-9]+_[A-Za-z0-9]+$/) && $conversationId !== 'direct_' + auth.uid + '_' + auth.uid) || root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['conversationId', 'conversationType', 'senderId', 'text', 'target', 'createdAt'])",

          "conversationId": {
            ".validate": "newData.val() === $conversationId"
          },
          "conversationType": {
            ".validate": "($conversationId.beginsWith('direct_') && newData.val() === 'direct') || (!$conversationId.beginsWith('direct_') && newData.val() === 'group')"
          },
          "senderId": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "target": {
            ".validate": "newData.hasChild('type') && (newData.child('type').val() !== 'member' || newData.hasChild('memberId'))",
            "type": {
              ".validate": "newData.val() === 'conversation' || (newData.val() === 'member' && !$conversationId.beginsWith('direct_'))"
            },
            "memberId": {
              ".validate": "newData.isString() && newData.parent().child('type').val() === 'member' && newData.val() !== auth.uid && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$index": {
              ".validate": "!$conversationId.beginsWith('direct_') && newData.isString() && newData.val() !== auth.uid && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
