# URL pública da API (sem barra no final)
EXPO_PUBLIC_API_URL=https://papo-api.onrender.com

# ID do projeto no EAS, gerado por `eas init` (para builds no EAS, cole também no app.config.ts)
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Caminho do google-services.json (Android). Em builds no EAS pode apontar para uma variável do tipo arquivo.
GOOGLE_SERVICES_JSON=./google-services.json
