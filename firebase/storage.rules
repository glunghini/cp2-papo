rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUpload();
    }

    // Consulta o Firestore para saber quem é o proprietário do grupo.
    match /groups/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isImageUpload()
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }
  }
}
